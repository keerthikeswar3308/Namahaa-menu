# Supabase Client Configuration (Exposed to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key-here

# Supabase Server-Only Secret (NEVER prefix with NEXT_PUBLIC_)
# Used ONLY in server-side API routes for administrative uploads and writes
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Optional custom admin passcode override (default: namahaa2026)
ADMIN_PASSCODE=namahaa2026
