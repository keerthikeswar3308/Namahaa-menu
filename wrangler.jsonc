{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "namahaa",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-08-31",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "placement": {
    "mode": "smart"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}

